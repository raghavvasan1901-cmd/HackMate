HACKMATE_SECRET_KEY=replace-this-with-a-long-random-secret
HACKMATE_DATABASE_URL=sqlite:///./hackmate.db
# Private PDFs are stored outside the publicly mounted static directory.
HACKMATE_PRIVATE_UPLOAD_DIR=instance/private_uploads
# Add only public iCalendar feeds that the provider/organizer permits automated access to.
# Keep feed URLs private if they contain access tokens; URLs are never exposed by the API.
HACKMATE_ICAL_FEEDS=[]
# Run `python -m app.sync_worker` as a separate single-instance process for scheduled sync.
HACKMATE_SYNC_INTERVAL_SECONDS=3600
# Comma-separated existing HackMate user IDs authorized to trigger/view sync operations.
HACKMATE_SYNC_ADMIN_USER_IDS=
# Existing account used as the creator of events imported by the scheduled worker.
HACKMATE_SYNC_OWNER_USER_ID=
# Google Gemini API configuration (used only by the authenticated backend).
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=20
AI_MAX_TOKENS=400
# Optional; defaults to HackMate's safe hackathon-collaboration instructions.
# AI_SYSTEM_INSTRUCTION=
